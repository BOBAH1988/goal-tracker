// Firebase Storage rules for the vision board images («Карта желаний»).
// Files live at users/{uid}/vision-board/{cardId}.{webp|jpg|png} — only the authenticated OWNER of
// that uid may read, write or delete them. Nothing here is public: every request is re-checked
// against these rules, and getDownloadURL tokens do not bypass them (they only make the URL
// unguessable).
//
// The app uploads the optimised 720×720 copy produced by the crop dialog: WebP where the engine
// can encode it, JPEG where it cannot (older iOS/Safari, rare WebViews). Both are legit — the
// object keeps the extension AND the contentType of its real bytes (see wishStorageExt in
// index.html), so a mismatch ("jpg bytes sent as image/webp") can never happen again the way it
// did when the path was hardcoded to .webp: the rules rejected it with storage/unauthorized and
// the photo silently stayed on the device it was added on. Junk of any other type, and every
// other path in the bucket, is denied.
//
// Deploy with: firebase deploy --only storage  (owner does this from the Firebase console/CLI;
// firebase.json in this folder maps storage -> storage.rules).
// Firestore rules stay independent — they hold only the card METADATA (id/title/imagePath/…).
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/vision-board/{cardId} {
      // Read: signed-in owner only.
      allow read: if request.auth != null && request.auth.uid == uid;
      // Delete: signed-in owner only (card removed from the board → no orphan objects).
      allow delete: if request.auth != null && request.auth.uid == uid;
      // Create/update: owner only, the optimised image copy only, ≤ 3 MB.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg|png)');
    }
    // Everything else in the bucket stays locked down.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}