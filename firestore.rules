// Firestore rules for «Только важное» (goal tracker).
// Deploy with: firebase deploy --only firestore  (see firebase.json in this folder).
//
// Same content as the setup instructions inside index.html — kept here so the owner can deploy
// every rule of the project with a single command instead of copy-pasting them in the console.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // «Карта желаний»: one document per card image (raw bytes, ≤ 800 KB — a 720×720 card is
      // 20–100 KB). Lives under the owner's uid, so nobody else can read or touch another
      // account's pictures. Cloud Storage is intentionally NOT used: it requires the paid
      // Blaze plan, while Firestore stays free on Spark.
      match /wishImages/{cardId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.bytes.size() <= 800 * 1024;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    // Usernames must be unique across the whole app. Anyone can read the collection
    // (needed to check availability before an account even exists). A name can only be
    // created once (Firestore treats writing to an existing doc as an "update", which is
    // blocked below), and only its own owner can delete their reservation when renaming.
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow update: if false;
    }
    // «Аналитика» (v1.4.0): админ-панель. Хардкод-админ (владелец проекта) тоже считается админом.
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid == '01l3xcqUPBZpOu67qNkj0uYJoqh1');
      allow write: if false;
    }
    match /userStats/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid == '01l3xcqUPBZpOu67qNkj0uYJoqh1' || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }
  }
}
